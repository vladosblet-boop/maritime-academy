---
layout: base.njk
pagination:
  data: sections
  size: 1
  alias: section
permalink: /sections/{{ section.id }}/
eleventyComputed:
  title: "{{ section.title }}"
---
<p class="crumbs"><a href="/catalog/">Каталог</a></p>
<h1>{{ section.title }}</h1>
<p>{{ section.description }}</p>
<ul class="article-list">
  {% for a in collections.articles %}
  {% if a.data.section == section.id %}
  <li>
    <a href="{{ a.url }}">{{ a.data.title }}</a>
    <span class="status status-{{ a.data.status | replace(' ', '-') }}">{{ a.data.status }}</span>
  </li>
  {% endif %}
  {% endfor %}
</ul>
<p class="empty">Остальные статьи раздела будут добавлены по плану CONTENT_PLAN.md.</p>
